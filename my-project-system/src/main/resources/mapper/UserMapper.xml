<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.my_project_system.mapper.UserMapper">
    <resultMap id="BaseResultMap" type="com.example.my_project_system.entity.User">
        <id column="id" property="id"/>
        <result column="username" property="username"/>
        <result column="password" property="password"/>
        <result column="createTime" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>
    <update id="updateById">
        UPDATE user
        SET phone = #{phone},
        email = #{email},
        status = #{status},
        update_time = NOW()
        WHERE id = #{id}
    </update>

    <select id="findByUsername" resultType="com.example.my_project_system.entity.User">
        SELECT * FROM `user` WHERE username = #{username}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `user`
        (username, password, create_time)
        VALUES
        (#{username}, #{password}, NOW())
    </insert>
    <select id="selectByUsernameAndPassword" resultType="com.example.my_project_system.entity.User">
        SELECT
        id,
        username,
        password,
        nickname,
        dept_name AS deptName,
        role_name AS roleName
        FROM user
        WHERE username = #{username}
        AND password = #{password}
    </select>
    <select id="countByUsername" resultType="java.lang.Integer">
        SELECT COUNT(*)
        FROM user
        WHERE username = #{username}
    </select>

</mapper>